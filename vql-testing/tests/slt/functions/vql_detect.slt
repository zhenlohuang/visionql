# ${BUILTIN_DETECTION_MODEL}
control substitution on

query T
CREATE TABLE photos USING IMAGES LOCATION '${IMAGES_LOCATION}';
----
created table 'photos'

query BB
WITH inferred AS (
  SELECT VQL_DETECT(
    image,
    classes => ['person'],
    min_score => 0.25
  ) AS detections
  FROM photos
  WHERE uri LIKE '%/000000000049.jpg'
)
SELECT
  CARDINALITY(detections) > 0 AS detected,
  detections[1]['locator'] IS NOT NULL AS localized
FROM inferred;
----
true true

query B
SELECT CARDINALITY(VQL_DETECT(
  image,
  classes => ['not_a_coco_label']
)) = 0 AS no_matches
FROM photos
WHERE uri LIKE '%/000000000049.jpg';
----
true
