control substitution on

query T
CREATE TABLE photos USING IMAGES LOCATION '${IMAGES_LOCATION}';
----
created table 'photos'

query T
CREATE MODEL detector TYPE OBJECT_DETECTION FROM '${MODEL}'
OPTIONS (image_size = 640, format = 'yolo_e2e', labels = 'coco80', box_format = 'xyxy');
----
created model 'detector'

query T
RESOLVE MODEL detector;
----
resolved model 'detector:v1'

query B
SELECT COUNT(*) > 0 AS found
FROM photos,
     UNNEST(detector(image,
       classes => ['person'],
       min_confidence => 0.25
     )) AS u(detection)
WHERE uri LIKE '%/000000000049.jpg';
----
true
