# ${BUILTIN_DETECTION_MODEL}
control substitution on

query T
CREATE TABLE photos USING IMAGES LOCATION '${IMAGES_LOCATION}';
----
created table 'photos'

query B
SELECT CARDINALITY(VQL_EXTRACT(
  image,
  classes => ['person'],
  min_confidence => 0.25
)) > 0 AS extracted
FROM photos
WHERE uri LIKE '%/000000000049.jpg';
----
true
