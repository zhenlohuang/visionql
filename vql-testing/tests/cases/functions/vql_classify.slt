# ${BUILTIN_CLASSIFICATION_MODEL}
control substitution on

query T
CREATE TABLE photos USING IMAGES LOCATION '${IMAGES_LOCATION}';
----
created table 'photos'

query B
SELECT CARDINALITY(VQL_CLASSIFY(
  image,
  ['football_helmet'],
  min_score => 0.5
)) > 0 AS classified
FROM photos
WHERE uri LIKE '%/000000000049.jpg';
----
true
