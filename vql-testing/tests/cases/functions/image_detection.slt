control substitution on

query T
CREATE TABLE photos USING IMAGES LOCATION '${IMAGES_LOCATION}';
----
created table 'photos' at revision 1

query T
CREATE MODEL detector TYPE OBJECT_DETECTION FROM '${MODEL}' USING ONNX_RUNTIME;
----
created model 'detector' at revision 2

query T
RESOLVE MODEL detector;
----
resolved model 'detector' at revision 3

query B
SELECT COUNT(*) > 0 AS found
FROM photos,
     UNNEST(IMAGE_DETECTION(
       'detector',
       image,
       classes => ['person'],
       min_confidence => 0.25
     )) AS u(detection)
WHERE uri LIKE '%/000000000049.jpg';
----
true
