control substitution on

query T
CREATE TABLE clips USING VIDEOS LOCATION '${VIDEOS_LOCATION}' OPTIONS (fps = 1);
----
created table 'clips'

query T
CREATE MODEL detector TYPE OBJECT_DETECTION FROM '${MODEL}'
OPTIONS (image_size = 640, format = 'yolo_e2e', labels = 'coco80', box_format = 'xyxy');
----
created model 'detector'

query T
RESOLVE MODEL detector;
----
resolved model 'detector:v1'

query IB
WITH per_window AS (
  SELECT
    TUMBLE(ts, INTERVAL '5' SECOND) AS window_start,
    SUM(CARDINALITY(detector(frame,
      classes => ['person'], min_confidence => 0.5
    ))) AS people
  FROM clips
  WHERE uri LIKE '%/people-detection.mp4'
  GROUP BY 1
)
SELECT
  CAST(COUNT(*) AS BIGINT) AS windows,
  SUM(people) > 0 AS found_people
FROM per_window;
----
4 true
