control substitution on

query T
CREATE TABLE clips USING VIDEOS LOCATION '${VIDEOS_LOCATION}' WITH (fps = 1);
----
created table 'clips' at revision 1

query T
CREATE MODEL detector TYPE OBJECT_DETECTION FROM '${MODEL}' USING ONNX_RUNTIME;
----
created model 'detector' at revision 2

query T
RESOLVE MODEL detector;
----
resolved model 'detector' at revision 3

query IB
WITH per_window AS (
  SELECT
    TUMBLE(ts, INTERVAL '5' SECOND) AS window_start,
    SUM(CARDINALITY(IMAGE_DETECTION(
      'detector', frame,
      classes => ['person'], min_confidence => 0.5
    ))) AS people
  FROM clips
  WHERE uri LIKE '%/people-detection.mp4'
  GROUP BY 1
)
SELECT
  CAST(COUNT(*) AS BIGINT) AS windows,
  SUM(people) > 0 AS found_people
FROM per_window;
----
4 true
